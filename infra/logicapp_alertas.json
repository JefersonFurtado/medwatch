{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "MedWatch — Logic App que recebe os alertas (WebhookChannel) por HTTP e envia e-mail à equipe médica via Gmail."
  },
  "parameters": {
    "workflowName": { "type": "string", "defaultValue": "la-medwatch-alertas" },
    "connectionName": { "type": "string", "defaultValue": "gmail-medwatch" },
    "location": { "type": "string", "defaultValue": "[resourceGroup().location]" },
    "recipient": { "type": "string", "metadata": { "description": "E-mail(s) da equipe, separados por ponto e vírgula." } },
    "minEmailSeverity": {
      "type": "int",
      "defaultValue": 3,
      "allowedValues": [1, 2, 3],
      "metadata": { "description": "Nível mínimo para enviar e-mail: 1=ATENÇÃO, 2=URGENTE, 3=CRÍTICO. Abaixo disso o alerta fica só no histórico de execuções." }
    }
  },
  "variables": {
    "gmailApiId": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'gmail')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[parameters('connectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "MedWatch - Gmail",
        "api": { "id": "[variables('gmailApiId')]" }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('workflowName')]",
      "location": "[parameters('location')]",
      "dependsOn": [ "[resourceId('Microsoft.Web/connections', parameters('connectionName'))]" ],
      "properties": {
        "state": "Enabled",
        "parameters": {
          "$connections": {
            "value": {
              "gmail": {
                "id": "[variables('gmailApiId')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', parameters('connectionName'))]",
                "connectionName": "[parameters('connectionName')]"
              }
            }
          },
          "recipient": { "value": "[parameters('recipient')]" },
          "minEmailSeverity": { "value": "[parameters('minEmailSeverity')]" }
        },
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": { "type": "Object", "defaultValue": {} },
            "recipient": { "type": "String", "defaultValue": "" },
            "minEmailSeverity": { "type": "Int", "defaultValue": 3 }
          },
          "triggers": {
            "manual": {
              "type": "Request",
              "kind": "Http",
              "inputs": { "method": "POST" }
            }
          },
          "actions": {
            "Responder": {
              "type": "Response",
              "kind": "Http",
              "runAfter": {},
              "inputs": { "statusCode": 202, "body": { "status": "recebido" } }
            },
            "Severidade_suficiente": {
              "type": "If",
              "runAfter": { "Responder": [ "Succeeded" ] },
              "expression": {
                "and": [
                  { "greaterOrEquals": [ "@int(coalesce(triggerBody()?['alert']?['severity_level'], 0))", "@parameters('minEmailSeverity')" ] }
                ]
              },
              "actions": {
                "Enviar_email": {
                  "type": "ApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "host": { "connection": { "name": "@parameters('$connections')['gmail']['connectionId']" } },
                    "method": "post",
                    "path": "/v2/Mail",
                    "body": {
                      "To": "@parameters('recipient')",
                      "Subject": "MedWatch @{triggerBody()?['title']}",
                      "IsHtml": true,
                      "Importance": "High",
                      "Body": "<div style='font-family:Segoe UI,Arial,sans-serif;max-width:640px'><div style='border-left:6px solid #@{triggerBody()?['themeColor']};padding:4px 12px'><h2 style='margin:4px 0'>@{triggerBody()?['title']}</h2><p>@{triggerBody()?['alert']?['message']}</p></div><table style='border-collapse:collapse;margin:12px 0'><tr><td style='padding:2px 12px 2px 0'><b>Paciente</b></td><td>@{triggerBody()?['alert']?['patient_id']}</td></tr><tr><td style='padding:2px 12px 2px 0'><b>Severidade</b></td><td>@{triggerBody()?['alert']?['severity']}</td></tr><tr><td style='padding:2px 12px 2px 0'><b>Fontes</b></td><td>@{join(triggerBody()?['alert']?['modalities'], ', ')}</td></tr><tr><td style='padding:2px 12px 2px 0'><b>Risco</b></td><td>@{triggerBody()?['alert']?['risk_score']}</td></tr><tr><td style='padding:2px 12px 2px 0'><b>Evento</b></td><td>@{triggerBody()?['alert']?['event_time']}</td></tr></table><p><b>Conduta sugerida:</b> @{triggerBody()?['alert']?['recommended_action']}</p><p style='color:#888;font-size:12px'>Alerta @{triggerBody()?['alert']?['alert_id']} gerado automaticamente pelo MedWatch. Apoio à decisão — não substitui avaliação clínica.</p></div>"
                    }
                  }
                }
              },
              "else": { "actions": {} }
            }
          },
          "outputs": {}
        }
      }
    }
  ],
  "outputs": {
    "connectionId": { "type": "string", "value": "[resourceId('Microsoft.Web/connections', parameters('connectionName'))]" }
  }
}
