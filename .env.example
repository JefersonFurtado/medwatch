# Copie para .env e preencha. Sem as chaves Azure o sistema roda em modo offline (fallback).

# --- Azure AI Speech (Speech to Text) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
AZURE_SPEECH_LANGUAGE=pt-BR

# --- Azure AI Language (Text Analytics: sentimento, frases-chave, Text Analytics for Health, PII) ---
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=https://<seu-recurso>.cognitiveservices.azure.com/
AZURE_LANGUAGE_CODE=pt-BR
AZURE_HEALTH_LANGUAGE=pt

# --- Alertas ---
# Webhook do Microsoft Teams (Workflows/Incoming Webhook), Slack ou Azure Logic Apps (gatilho HTTP)
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MIN=15
ALERT_MIN_SEVERITY=ATENCAO

# --- Vídeo ---
POSE_BACKEND=yolov8            # yolov8 | openpose
VIDEO_FRAME_STRIDE=2
VIDEO_CONF=0.35
# YOLO_POSE_WEIGHTS=models/yolov8n-pose.pt
# YOLO_DET_WEIGHTS=models/yolov8n.pt
# OPENPOSE_PROTO=models/pose_deploy_linevec.prototxt
# OPENPOSE_WEIGHTS=models/pose_iter_440000.caffemodel
